{
  "name": "compact-dsh",
  "private": true,
  "type": "module",
  "description": "The Compact on DeepSeek Harness — plugin composition, annex, and ratification work.",
  "scripts": {
    "compact": "node tools/compact-dsh.mjs",
    "compact:smoke": "node tools/compact-dsh.mjs --smoke",
    "compact:bake": "node tools/bake.mjs",
    "dist": "node tools/dist.mjs",
    "dist:probe": "node tools/dist-probe.mjs",
    "test": "node --test \"packages/*/test/*.test.js\" \"tools/*.test.mjs\"",
    "test:live": "COMPACT_LIVE_TEST=1 node --test \"packages/blessed/test/live/*.test.mjs\"",
    "test:bake": "COMPACT_BAKE_TEST=1 node --test tools/bake.test.mjs",
    "test:dist-probe": "COMPACT_DIST_PROBE=1 node --test tools/dist-probe.test.mjs",
    "verify-pin": "node tools/verify-pin.mjs",
    "verify-register": "node tools/verify-register.mjs"
  },
  "engines": {
    "node": ">=22.19"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "^0.2.0-rc.2"
  },
  "workspaces": [
    "packages/*"
  ]
}
